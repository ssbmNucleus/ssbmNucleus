<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="HSDRaw"><HintPath>$(HsdLibraryPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireLibrary" BeforeTargets="ResolveReferences" Condition="'$(HsdLibraryPath)' == ''">
    <Error Text="An explicit HsdLibraryPath is required." />
  </Target>
</Project>
