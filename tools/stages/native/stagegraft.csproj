<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>stagegraft</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HSDRaw"><HintPath>$(HSDRawPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireHSDRaw" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HSDRawPath)')" Text="Pass -p:HSDRawPath=... pointing at the configured Nucleus HSDRaw.dll." />
  </Target>
</Project>
